{
  "manifest_version": 3,
  "name": "AutoOutreach - AI Job & Startup Copilot",
  "version": "1.1.0",
  "description": "Autonomous 1-click decision maker email finder and tailored cold outreach generator for LinkedIn, Twitter, and company sites.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
